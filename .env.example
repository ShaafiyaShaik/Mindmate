# Example environment variables for mindmate-app
# Copy this file to .env.local for local development and fill values.

# Use MongoDB as the database client
DB_CLIENT=mongodb

# Your MongoDB connection string for local or Atlas (replace <password> and host)
MONGODB_URI=mongodb://127.0.0.1:27017/mindmate

# Optional DB name (defaults to 'mindmate')
MONGODB_DBNAME=mindmate

# Gemini / AI API key
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=

# JWT secret used for signing auth tokens
JWT_SECRET=replace_with_a_random_secret

# Not recommended for Vercel: path to sqlite file if you want sqlite instead
# DB_FILE=./data/db.sqlite
